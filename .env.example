# ─── Bắt buộc ─────────────────────────────────────
DATABASE_URL=mysql+aiomysql://docgen:docgenpassword@db:3306/docgen

# Đổi trong production! (đổi là toàn bộ token cũ hết hiệu lực)
API_SECRET_KEY=your-secret-key-here

# ─── Tùy chọn (đều sửa được trên màn hình Cấu hình sau khi chạy) ──
DEBUG=false
AI_ENABLED=true
OLLAMA_API_KEY=

MAX_CONCURRENT_RENDERS=10
RENDER_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=20

# QR trên lệnh trỏ về domain này + /verify/{mã}
PUBLIC_WEB_URL=http://localhost:3000

# Nhắc hết hạn hằng đêm (7h sáng)
SCHEDULER_ENABLED=false
NOTIFY_WITHIN_DAYS=30

# Email SMTP (để trống = không gửi mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAILS=

# Zalo OA (để trống = không gửi Zalo)
ZALO_OA_TOKEN=
ZALO_USER_IDS=
